{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mac-organizer",
  "description": "Extension for help organize mac os",
  "categories": [
    "Productivity",
    "Media"
  ],
  "license": "MIT",
  "author": "teziovsky",
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "fix": "npm run fix-lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "pull-contributions": "npx @raycast/api@latest pull-contributions",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "@raycast/utils": "^2.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@raycast/eslint-config": "^2.1.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "icon": "extension-icon.png",
  "commands": [
    {
      "mode": "view",
      "name": "organize-icloud-photos",
      "title": "Organize iCloud Photos",
      "description": "Export and organize iCloud Photos",
      "subtitle": "Mac Organizer"
    }
  ],
  "platforms": [
    "macOS"
  ],
  "title": "Mac Organizer"
}
